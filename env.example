# Pushover Alarm Project - Environment Variables
# ─────────────────────────────────────────────────────────────────
# Run "node setup.js" to generate this file automatically,
# OR copy this file to ".env" and fill in your values manually.
# ─────────────────────────────────────────────────────────────────

# Your Pushover User Key (from https://pushover.net dashboard)
PUSHOVER_USER_KEY=your_user_key_here

# Your Pushover App Token (create an app at https://pushover.net/apps)
PUSHOVER_APP_TOKEN=your_app_token_here

# Port for the local server
PORT=3000
